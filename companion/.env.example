# Copy this file to .env (same folder) and fill in your key. Never commit .env.
# Without a key, the app uses the built-in Mac voice.
ELEVENLABS_API_KEY=
# Optional: pick a voice in the ElevenLabs Voice Library and paste its ID here.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Optional: eleven_v4 (newest, best quality) or eleven_flash_v2_5 (faster, cheaper)
ELEVENLABS_MODEL=eleven_v4
# Optional: speaking speed 0.7-1.2 (older models only; eleven_v4 ignores it)
ELEVENLABS_SPEED=0.9
